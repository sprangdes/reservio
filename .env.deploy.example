# Spring profile
SPRING_PROFILES_ACTIVE=prod

# Neon PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://<NEON_HOST>/<DB_NAME>?sslmode=require
SPRING_DATASOURCE_USERNAME=<NEON_USER>
SPRING_DATASOURCE_PASSWORD=<NEON_PASSWORD>

# OAuth / auth settings
LINE_LOGIN_CHANNEL_ID=<LINE_CHANNEL_ID>
LINE_LOGIN_CHANNEL_SECRET=<LINE_CHANNEL_SECRET>
LINE_LOGIN_CALLBACK_BASE_URL=https://api.your-domain.com
LINE_LOGIN_SUCCESS_REDIRECT_PATH=/login
LINE_LOGIN_FAILURE_REDIRECT_PATH=/login

# Frontend origin for CORS
CORS_ALLOWED_ORIGINS=https://www.your-domain.com,https://your-domain.com
