# Backend local env template
# Copy to .env.local

SPRING_PROFILES_ACTIVE=local

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/reservio
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

LINE_LOGIN_CHANNEL_ID=<LOCAL_LINE_CHANNEL_ID>
LINE_LOGIN_CHANNEL_SECRET=<LOCAL_LINE_CHANNEL_SECRET>
LINE_LOGIN_CALLBACK_BASE_URL=http://localhost:8080

# ngrok script will override these two during startup, normally no need to edit.
LINE_LOGIN_SUCCESS_REDIRECT_PATH=/login
LINE_LOGIN_FAILURE_REDIRECT_PATH=/login

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.ngrok-free.app
